OPENAI_API_KEY=
PORT=

# Shared password required to access the whole site (static pages + API).
# Leave unset to keep the site open with no login (e.g. local dev).
SITE_PASSWORD=

# Default image model (gpt-image-2.5-sunburst if unset)
IMAGE_MODEL=

# Persist feedback / prompt versions / images to a private GitHub repo.
# Leave unset to use the local data/ folder (fine for local dev).
# GITHUB_TOKEN: fine-grained token with Contents read/write on that repo only.
GITHUB_DATA_REPO=
GITHUB_TOKEN=
